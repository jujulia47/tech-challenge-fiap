# Copy to .env, which is outside git, and fill in. docker compose reads it and refuses to start without these.

# Signs the session. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=replace-me

# Encrypts the attachments: 32 bytes in base64. Generate with the same command.
# Changing it makes the attachments already stored unreadable.
ATTACHMENT_ENCRYPTION_KEY=replace-me

# The database. json-server is the default, and needs nothing here.
# With supabase, the apps use the project below: docs/fase4/deploy.md. Server only, never NEXT_PUBLIC_.
DATA_BACKEND=json-server
SUPABASE_URL=
# The secret key (sb_secret_...), which bypasses RLS. Never in the browser, never in git.
SUPABASE_SECRET_KEY=
# Only for the proof that the public key reads nothing: docs/fase4/deploy.md
SUPABASE_PUBLISHABLE_KEY=

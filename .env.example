# Copy to .env, which is outside git, and fill in. docker compose reads it and refuses to start without these.

# Signs the session. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=replace-me

# Encrypts the attachments: 32 bytes in base64. Generate with the same command.
# Changing it makes the attachments already stored unreadable.
ATTACHMENT_ENCRYPTION_KEY=replace-me

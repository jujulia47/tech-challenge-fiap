# Copy to .env.local for npm run dev. The same values as the README, "Como rodar sem Docker".

# 32 random bytes in base64, the same in the three apps. Generate as in step 3 of the README:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The app refuses to start with replace-me or a shorter value.
NEXTAUTH_SECRET=replace-me

# 32 random bytes in base64, the same in dashboard and transactions, generated the same way
ATTACHMENT_ENCRYPTION_KEY=replace-me

# Where the proxy of the zone sends a visitor with no session
SHELL_URL=http://localhost:3000

# Server only: never add the NEXT_PUBLIC_ prefix to these
JSON_SERVER_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000

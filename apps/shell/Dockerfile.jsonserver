# json-server is installed here, so starting the container needs no network.
# docker-compose.yml mounts the data at /app. Railway has no mount, so the seed lives outside /app.
FROM node:22-alpine
RUN npm install -g json-server@1.0.0-beta.15
COPY apps/shell/data/db.seed.json /seed/db.seed.json
# Without its file watcher: it reloads db.json after a write and, under load, the reload undoes the
# next PATCH (docs/fase4/testing.md, "Known instabilities"). A reset needs a restart either way.
# In production mode json-server serves ./public, so it runs from a folder that has an empty one.
ENV NODE_ENV=production
RUN mkdir -p /srv/public
WORKDIR /app
EXPOSE 3001
CMD ["sh", "-c", "[ -f db.json ] || cp /seed/db.seed.json db.json; cd /srv && exec json-server /app/db.json --port 3001 --host 0.0.0.0"]

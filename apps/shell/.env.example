# Copy to .env.local for npm run dev. The same values as the README, "Como rodar sem Docker".

# 32 random bytes in base64, the same in the three apps. Generate as in step 3 of the README:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The app refuses to start with replace-me or a shorter value.
NEXTAUTH_SECRET=replace-me

# The public address of the shell, for the link of the reset email
SHELL_URL=http://localhost:3000

# Server only: never add the NEXT_PUBLIC_ prefix to these
JSON_SERVER_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000

# Mailpit, started by hand (README). 127.0.0.1, not localhost: Node tries ::1 first, where Mailpit
# is not listening. Without SMTP_HOST, email is off and the server logs one line instead.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=Bytebank <no-reply@bytebank.local>
# Optional: only for a server that asks for login
SMTP_USER=
SMTP_PASS=

{
  "name": "bytebank",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:reset": "npm run db:reset --workspace=@bytebank/shell",
    "db:seed:supabase": "node --env-file=.env packages/infrastructure/scripts/supabase-demo.mjs seed",
    "db:clean:supabase": "node --env-file=.env packages/infrastructure/scripts/supabase-demo.mjs clean",
    "db:reset:supabase": "node --env-file=.env packages/infrastructure/scripts/supabase-demo.mjs reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:session-race": "node apps/shell/scripts/session-race.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "turbo": "^2.11.10",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
